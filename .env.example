# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Shared secret AgenticOrg sends in the x-api-key header (long random string)
MCP_API_KEY=replace-with-a-long-random-string

# Neon Postgres (set automatically when Neon is added from Vercel → Storage)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Twilio (Console → Account info)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-me

# ── Incoming WhatsApp → Janus. Pick ONE route (or force it with INBOUND_FORWARD_MODE=agenticorg|email|none).

# Route 1: AgenticOrg "run workflow" API. Needs an org-admin API key (ao_sk_…) with workflows:run scope.
AGENTICORG_WEBHOOK_URL=https://<agenticorg-host>/api/v1/workflows/<workflow-id>/run
AGENTICORG_API_KEY=ao_sk_replace-me

# Route 2 (fallback): email each message as JSON to the Janus Gmail inbox.
# GMAIL_USER sends it, using a Google "App Password" (needs 2-Step Verification on that account).
GMAIL_USER=relay-account@gmail.com
GMAIL_APP_PASSWORD=replace-me
JANUS_INBOX_EMAIL=janus-inbox@gmail.com

# Optional: the exact public URL Twilio calls, if signature checks fail behind a custom domain
# TWILIO_WEBHOOK_URL=https://janus-server.vercel.app/api/twilio/inbound

# Gnani
GNANI_API_KEY=replace-me

# Vercel Blob (for generated text-to-speech audio)
BLOB_READ_WRITE_TOKEN=replace-me
